etry" /></mxCell><mxCell id="pr-3" value="&lt;b&gt;Layer 4 · Regional DR&lt;/b&gt;&lt;br&gt;Riyadh → Rakeezah · async · separate failure domain" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673A6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="759" y="114" width="234" height="38" as="geometry" /></mxCell><mxCell id="dmz-gslb" value="&lt;b&gt;GSLB / DNS → F5 / API gateway&lt;/b&gt;&lt;br&gt;user traffic path only — not storage / DR" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;fontSize=10;fillColor=#ffffff;strokeColor=#d6b656;align=center;verticalAlign=middle;" vertex="1" parent="zone-dmz"><mxGeometry x="310" y="58" width="190" height="38" as="geometry" /></mxCell><mxCell id="e-gslb-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;;exitX=0.2;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="dmz-gslb" target="dc-asas1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-gslb-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;;exitX=0.8;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="dmz-gslb" target="dc-asas2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="stor-asas1" value="&lt;b&gt;Internal ODF / Ceph storage&lt;/b&gt; · local to DC1&lt;br&gt;Production workload&lt;br&gt;own failure domain" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0F62FE;strokeWidth=2;fontSize=11;" vertex="1" parent="dc-asas1"><mxGeometry x="30" y="300" width="270" height="64" as