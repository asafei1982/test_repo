llColor=#ffffff;strokeWidth=2;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="p2-dc1"><mxGeometry x="50" y="60" width="280" height="54" as="geometry" /></mxCell><mxCell id="p2-vm1" value="RHEL VM · Layer 2 — DB2 HA" style="rounded=1;arcSize=8;dashed=1;dashPattern=8 4;strokeColor=#82b366;fillColor=#f1f8ef;strokeWidth=1;fontSize=11;fontStyle=0;whiteSpace=wrap;html=1;verticalAlign=top;" vertex="1" parent="p2-dc1"><mxGeometry x="20" y="148" width="340" height="256" as="geometry" /></mxCell><mxCell id="p2-db1" value="&lt;b&gt;Db2 instance&lt;/b&gt;&lt;br&gt;HADR Primary (DC1)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0F62FE;strokeWidth=2;fontSize=11;align=left;spacingLeft=72;verticalAlign=middle;" vertex="1" parent="p2-vm1"><mxGeometry x="20" y="44" width="300" height="96" as="geometry" /></mxCell><mxCell id="p2-dbi1" value="" style="shape=rect;fillColor=#0F62FE;aspect=fixed;resizable=0;strokeColor=none;html=1;" vertex="1" parent="p2-db1"><mxGeometry x="12" y="24" width="48" height="48" as="geometry" /></mxCell><mxCell id="p2-dbi1-g" value="" style="fillColor=#ffffff;strokeColor=none;dashed=0;outlineConnect=0;html=1;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;part=1;movable=0;resizable=0;rotatable=0;shape=mxgraph.ibm_cloud.ibm--db2" parent="p2-dbi1" vertex="1">
          <mxGeometry width="24" height="24" relative="1" as="geometry">
            <mxPoint x="12" y="12" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-pm1" value="&lt;b&gt;Pacemaker&lt;/b&gt;&lt;br&gt;cluster node · monitors Db2 · manages failover" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#B85450;strokeWidth=2;fontSize=11;" vertex="1" parent="p2-vm1"><mxGeometry x="20" y="170" width="300" height="64" as="geometry" /></mxCell><mxCell id="p2-dc2" value="ASAS-2 (Riyadh) — DC2 · ~700 m from DC1" style="rounded=1;arcSize=6;dashed=1;dashPattern=8 4;strokeColor=#82b366;fillColor=#ffffff;strokeWidth=2;fontSize=13;fontStyle=1;whiteSpace=wrap;html=1;verticalAlign=top;" vertex="1" parent="p2-ha"><mxGeometry x="600" y="44" width="380" height="430" as="geometry" /></mxCell><mxCell id="p2-cap2" value="Layer 1 · Infrastructure — Active-Active" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#666666;" vertex="1" parent="p2-dc2"><mxGeometry x="10" y="32" width="360" height="22" as="geometry" /></mxCell><mxCell id="p2-st2" value="Storage&lt;br&gt;(product to confirm)" style="rounded=1;arcSize=8;dashed=1;dashPattern=2 3;strokeColor=#666666;fillColor=#ffffff;strokeWidth=2;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="p2-dc2"><mxGeometry x="50" y="60" width="280" height="54" as="geometry" /></mxCell><mxCell id="p2-vm2" value="RHEL VM · Layer 2 — DB2 HA" style="rounded=1;arcSize=8;dashed=1;dashPattern=8 4;strokeColor=#82b366;fillColor=#f1f8ef;strokeWidth=1;fontSize=11;fontStyle=0;whiteSpace=wrap;html=1;verticalAlign=top;" vertex="1" parent="p2-dc2"><mxGeometry x="20" y="148" width="340" height="256" as="geometry" /></mxCell><mxCell id="p2-db2" value="&lt;b&gt;Db2 instance&lt;/b&gt;&lt;br&gt;HADR Standby (DC2)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0F62FE;strokeWidth=2;fontSize=11;align=left;spacingLeft=72;verticalAlign=middle;" vertex="1" parent="p2-vm2"><mxGeometry x="20" y="44" width="300" height="96" as="geometry" /></mxCell><mxCell id="p2-dbi2" value="" style="shape=rect;fillColor=#0F62FE;aspect=fixed;resizable=0;strokeColor=none;html=1;" vertex="1" parent="p2-db2"><mxGeometry x="12" y="24" width="48" height="48" as="geometry" /></mxCell><mxCell id="p2-dbi2-g" value="" style="fillColor=#ffffff;strokeColor=none;dashed=0;outlineConnect=0;html=1;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;part=1;movable=0;resizable=0;rotatable=0;shape=mxgraph.ibm_cloud.ibm--db2" parent="p2-dbi2" vertex="1">
          <mxGeometry width="24" height="24" relative="1" as="geometry">
            <mxPoint x="12" y="12" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-pm2" value="&lt;b&gt;Pacemaker&lt;/b&gt;&lt;br&gt;cluster node · monitors Db2 · manages failover" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#B85450;strokeWidth=2;fontSize=11;" vertex="1" parent="p2-vm2"><mxGeometry x="20" y="170" width="300" height="64" as="geometry" /></mxCell><mxCell id="p2-hab" value="Db2 HADR + Pacemaker HA cluster — DC1 + DC2 only (not stretched to DC3)" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;strokeColor=#B85450;fillColor=none;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#B85450;whiteSpace=wrap;html=1;verticalAlign=top;" vertex="1" parent="p2-ha"><mxGeometry x="30" y="170" width="940" height="290" as="geometry" /></mxCell><mxCell id="p2-quorum" value="Quorum / fencing&lt;br&gt;design: to confirm" style="rounded=1;arcSize=8;dashed=1;dashPattern=2 3;strokeColor=#666666;fillColor=#ffffff;strokeWidth=2;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="p2-ha"><mxGeometry x="415" y="412" width="170" height="44" as="geometry" /></mxCell><mxCell id="p2-callout" value="Infrastructure Active-Active (Layer 1) and Db2 HA (Layer 2) are related but separate layers: the infrastructure pair is Active-Active, while Db2 runs as HADR Primary / Standby under Pacemaker. HADR replicates database logs between Db2 instances; it is not storage replication. ODF DR (Layer 3) and Regional-DR protect OpenShift persistent volumes and application data only; they are not connected to the Db2 VMs." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1;fontSize=11;" vertex="1" parent="p2-ha"><mxGeometry x="20" y="490" width="960" height="56" as="geometry" /></mxCell><mxCell id="p2-dc3" value="DC3 — Rakeezah (Jeddah) · Independent DR" style="rounded=1;arcSize=10;dashed=1;dashPattern=8 4;strokeColor=#82b366;fillColor=#d5e8d4;strokeWidth=2;fontSize=14;fontStyle=1;whiteSpace=wrap;html=1;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1180" y="170" width="440" height="560" as="geometry" /></mxCell><mxCell id="p2-cap3" value="Layer 4 · Regional DR — independent site, outside the DC1 + DC2 cluster" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#666666;" vertex="1" parent="p2-dc3"><mxGeometry x="10" y="76" width="420" height="22" as="geometry" /></mxCell><mxCell id="p2-st3" value="Storage&lt;br&gt;(product to confirm)" style="rounded=1;arcSize=8;dashed=1;dashPattern=2 3;strokeColor=#666666;fillColor=#ffffff;strokeWidth=2;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="p2-dc3"><mxGeometry x="60" y="104" width="320" height="54" as="geometry" /></mxCell><mxCell id="p2-vm3" value="RHEL VM · DR copy of Db2" style="rounded=1;arcSize=8;dashed=1;dashPattern=8 4;strokeColor=#82b366;fillColor=#f1f8ef;strokeWidth=1;fontSize=11;fontStyle=0;whiteSpace=wrap;html=1;verticalAlign=top;" vertex="1" parent="p2-dc3"><mxGeometry x="20" y="192" width="400" height="270" as="geometry" /></mxCell><mxCell id="p2-db3" value="&lt;b&gt;Db2 instance&lt;/b&gt;&lt;br&gt;DR copy&lt;br&gt;(replication mechanism: to confirm)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0F62FE;strokeWidth=2;fontSize=11;align=left;spacingLeft=72;verticalAlign=middle;" vertex="1" parent="p2-vm3"><mxGeometry x="20" y="44" width="360" height="96" as="geometry" /></mxCell><mxCell id="p2-dbi3" value="" style="shape=rect;fillColor=#0F62FE;aspect=fixed;resizable=0;strokeColor=none;html=1;" vertex="1" parent="p2-db3"><mxGeometry x="12" y="24" width="48" height="48" as="geometry" /></mxCell><mxCell id="p2-dbi3-g" value="" style="fillColor=#ffffff;strokeColor=none;dashed=0;outlineConnect=0;html=1;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;part=1;movable=0;resizable=0;rotatable=0;shape=mxgraph.ibm_cloud.ibm--db2" parent="p2-dbi3" vertex="1">
          <mxGeometry width="24" height="24" relative="1" as="geometry">
            <mxPoint x="12" y="12" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-note3" value="To confirm: RPO / RTO · local Db2 HA at DC3 · DR activation (manual or automated) · client re-routing. DC3 is not a member of the DC1 + DC2 Pacemaker cluster." style="rounded=1;arcSize=8;dashed=1;dashPattern=2 3;strokeColor=#666666;fillColor=#ffffff;strokeWidth=2;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="p2-vm3"><mxGeometry x="20" y="160" width="360" height="84" as="geometry" /></mxCell><mxCell id="p2-ban3" value="Layer 4 — the Db2 DR copy at DC3 receives replication from the HA environment and never joins its cluster. Mechanism: TBC / design pending." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#666666;" vertex="1" parent="p2-dc3"><mxGeometry x="10" y="490" width="420" height="40" as="geometry" /></mxCell><mxCell id="p2-e-fibre" value="~700 m fibre" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#666666;strokeWidth=4;endArrow=none;startArrow=none;exitX=1;exitY=0.0884;entryX=0;entryY=0.0884;" edge="1" parent="1" source="p2-dc1" target="p2-dc2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-e-sync" value="synchronous&lt;br&gt;replication" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#D79B00;startArrow=block;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2-st1" target="p2-st2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-e-hadr" value="HADR replication&lt;br&gt;Primary → Standby" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#0066CC;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="p2-db1" target="p2-db2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-e-take" value="takeover on failure&lt;br&gt;(Pacemaker-managed)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#B85450;dashed=1;dashPattern=8 4;exitX=0;exitY=0.72;entryX=1;entryY=0.72;" edge="1" parent="1" source="p2-db2" target="p2-db1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-e-clu" value="cluster communication" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#B85450;dashed=1;dashPattern=8 4;startArrow=block;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2-pm1" target="p2-pm2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-e-c1" value="controls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#B85450;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="p2-pm1" target="p2-db1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-e-c2" value="controls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#B85450;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="p2-pm2" target="p2-db2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-e-link" value="inter-site link&lt;br&gt;(to confirm)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#666666;strokeWidth=4;endArrow=none;startArrow=none;dashed=1;dashPattern=2 3;exitX=1;exitY=0.1464;entryX=0;entryY=0.1464;" edge="1" parent="1" source="p2-ha" target="p2-dc3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-e-dr" value="DR replication&lt;br&gt;(mechanism to confirm)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673A6;dashed=1;dashPattern=8 4;exitX=1;exitY=0.393;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2-hab" target="p2-db3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-banner" value="DC1 + DC2 Active-Active HA   →   DB2 HADR + Pacemaker   →   DC3 Independent DR" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#4277BB;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="748" width="1580" height="40" as="geometry" /></mxCell><mxCell id="p2-notes" value="Assumptions / open points" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="layer-notes"><mxGeometry x="40" y="810" width="1000" height="330" as="geometry" /></mxCell><mxCell id="p2-notes-t" value="1. DC1 / DC2 / DC3 = ASAS-1, ASAS-2 and Rakeezah, following the earlier project material. DC3 distance, latency, bandwidth and link redundancy are not in the sources.&lt;br&gt;2. DC1 and DC2 are Active-Active, about 700 m apart, with synchronous replication (SDAIA-confirmed context). What that replication covers (storage product, volumes, VM disks) is not stated. Confirm it is not also applied to the Db2 HADR volumes, because HADR already keeps its own copy of the database.&lt;br&gt;3. Db2 on RHEL VMs with HADR + Pacemaker is the target architecture. To confirm: HADR synchronisation mode, which site holds the primary (DC1 is shown for illustration), automatic or manual takeover, and the Db2, RHEL and Pacemaker versions.&lt;br&gt;4. Pacemaker quorum / tie-breaker and fencing for a two-site cluster are not defined. A tie-breaker placed outside DC1 and DC2 does not make that site a member of the Db2 cluster.&lt;br&gt;5. Db2 DR to DC3: replication mechanism, direction after a failover, RPO and RTO are not defined, so the link is shown as design pending. DC3 is not part of the Pacemaker cluster.&lt;br&gt;6. DC3: local Db2 HA, DR activation (manual or automated) and client re-routing are to be confirmed.&lt;br&gt;7. Db2 on VMs sits outside OpenShift; ODF DR on the overview page does not cover it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingLeft=4;" vertex="1" parent="p2-notes"><mxGeometry x="10" y="30" width="980" height="290" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>